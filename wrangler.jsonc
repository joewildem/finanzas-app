{
  "$schema": "node_modules/wrangler/config-schema.json",
  // `name` es el Worker de destino, no el nombre del producto (Fincap). Renombrarlo no renombra
  // nada en Cloudflare: crea un Worker nuevo y deja el dominio y el auto-deploy apuntando al viejo.
  "name": "finanzas-app",
  "compatibility_date": "2026-08-24",
  // Dominio de producción, versionado aquí en vez de vivir solo en el dashboard. Sustituyó a
  // `financial-control.jpmx.pro` el 2026-09-07, al ponerle nombre al producto.
  "routes": [{ "pattern": "fincap.jpmx.pro", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
